# Supabase project API URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key. Authorization is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_APP_URL=https://kidmemoir.com

# Supabase server-only key used exclusively by verified billing webhooks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend transactional email (server-only)
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL="KidMemoir Support <support@your-verified-domain.com>"
SUPPORT_EMAIL_TO=hello@kidmemoir.com

# Lemon billing (server-only)
LEMON_API_KEY=your-lemon-api-key
LEMON_STORE_ID=your-store-id
LEMON_PRODUCT_ID=your-premium-product-id
LEMON_VARIANT_ID=your-premium-variant-id
LEMON_WEBHOOK_SECRET=your-webhook-secret

# OpenAI intelligence engine (server-only)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5-nano-2025-08-07
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_INPUT_COST_PER_MILLION=0.05
OPENAI_OUTPUT_COST_PER_MILLION=0.40
OPENAI_EMBEDDING_COST_PER_MILLION=0.02

# At least 32 random characters; also configure as the Vercel cron secret.
CRON_SECRET=replace-with-a-cryptographically-random-secret
