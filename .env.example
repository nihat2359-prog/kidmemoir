# Supabase project API URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key. Authorization is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Resend transactional email (server-only)
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL="KidMemoir Support <support@your-verified-domain.com>"
SUPPORT_EMAIL_TO=hello@kidmemoir.com

# Lemon billing (server-only; checkout integration is intentionally disabled)
LEMON_API_KEY=your-lemon-api-key
LEMON_STORE_ID=your-store-id
LEMON_VARIANT_ID=your-premium-variant-id
LEMON_WEBHOOK_SECRET=your-webhook-secret
LEMON_SIGNING_SECRET=your-signing-secret
